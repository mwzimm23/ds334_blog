##Pulling and joining the grade dataset
url <- "https://worldrainforests.com/deforestation/archive/United_States.htm"
page <- read_html(url)
table_data <- page |>
html_elements("table")|>
html_table(fill = TRUE)
timber_table <- table_data[[5]] |> mutate(across(matches("ha|%"), ~ as.numeric(gsub("[,%]", "", .))))|>
type_convert(
col_types = cols(
`Sub-national admin area 1` = col_character(),
`Tree cover loss(2001-05)ha` = col_double(),
`Tree cover loss(2006-10)ha` = col_double(),
`Tree cover loss(2011-15)ha` = col_double(),
`Tree cover loss(2016-20)ha` = col_double(),
`Tree cover loss(2001-20)ha` = col_double(),
`Tree cover loss(2001-20)%` = col_double()))|>
rename(state = 'Sub-national admin area 1',OriginalCover = 'Tree cover extent(2001)ha', Loss2001_05 = 'Tree cover loss(2001-05)ha', Loss2006_10 = 'Tree cover loss(2006-10)ha', Loss2011_15 = 'Tree cover loss(2011-15)ha', Loss2016_20 = 'Tree cover loss(2016-20)ha', TotalCoverLoss = 'Tree cover loss(2001-20)ha', Loss_percent = 'Tree cover loss(2001-20)%')
timber_table
library(usmap)
states_data <- us_map(regions = "states")
head(timber_table)
state_full <- left_join(states_data, timber_table, by = c("full" = "state"))
##Extent vs loss
timberfordiff<-timber_table|>pivot_longer(
cols = c(OriginalCover, TotalCoverLoss),
names_to = "When",
values_to = "hectares"
)
ggplot(data = timberfordiff, aes(x = state, y = hectares, fill = When))+
geom_col(position = position_dodge(width = 0.8)) +
labs(x = "State", y = "Tree cover loss (ha)", fill = "Period") +
theme_minimal()+
coord_flip()+
scale_fill_manual(
values = c(OriginalCover = "blue",
TotalCoverLoss = "red"))
timber_table <- table_data[[5]]
timber_table
ggplot(state_full) +
geom_sf(aes(fill = Total_cover_loss_percent), color = "black") +
theme_void() +
scale_fill_viridis_c(option = "plasma")
